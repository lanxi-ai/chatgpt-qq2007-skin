{
  "manifest_version": 3,
  "name": "ChatGPT皮肤·QQ2007版",
  "version": "0.8.3",
  "description": "为ChatGPT网页版添加怀旧配色、头像资料、本机娱乐等级及回复提示音。第三方扩展，与OpenAI或腾讯无官方关联，不改变账号权益。",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT皮肤·QQ2007版",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "site-adapter.js",
        "retro-icons.js",
        "avatar-catalog.js",
        "avatars.js",
        "profile.js",
        "feedback.js",
        "decor.js",
        "nudge.js",
        "panel.js",
        "reply-watch.js",
        "content.js"
      ],
      "css": [
        "theme.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png",
        "assets/avatars/*",
        "assets/audio/*.wav"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
